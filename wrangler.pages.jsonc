{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetheros",
  "pages_build_output_dir": "client/dist",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  }
}
